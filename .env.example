# Copy to .env and fill in. Normally only the four LLM_* values below need changing.

# --- LLM ---
# anthropic = Claude Messages API (Anthropic, or a proxy such as Vocareum's Claude endpoint)
# openai    = any OpenAI-compatible Chat Completions API (llama.cpp llama-server, OpenAI, proxies)
LLM_PROVIDER=anthropic
LLM_API_KEY=your-api-key
# anthropic: the host root WITHOUT /v1 (the SDK adds /v1/messages). Leave empty for api.anthropic.com.
# openai:    must END with /v1, e.g. http://192.168.1.50:8080/v1
LLM_BASE_URL=https://your-provider-endpoint
# The exact model ID your provider gives you, e.g. claude-sonnet-5-5 (anthropic) or qwen3.8-27b (llama.cpp)
LLM_MODEL=claude-sonnet-5-5
# anthropic only: api_key sends the key as the x-api-key header (standard);
# bearer sends "Authorization: Bearer <key>" (try this if a proxy returns 401 with a correct key)
LLM_AUTH_STYLE=api_key
# openai only (current Claude models don't accept a temperature setting)
LLM_TEMPERATURE=0.2
# Max length of one model reply. Claude writes detailed handoff summaries; below ~1500 they can be cut off.
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=120
# openai only: constrain output to JSON via response_format (llama.cpp turns it into a grammar).
# Auto-disables if the server rejects it.
LLM_JSON_MODE=true
# Older names still work as fallbacks: OPENAI_API_KEY / OPENAI_BASE_URL (openai), ANTHROPIC_API_KEY /
# ANTHROPIC_BASE_URL (anthropic). LLM_API_KEY / LLM_BASE_URL take priority when both are set.

# --- Agent authority & policy ---
CURRENCY=USD
RETURN_AUTHORITY_LIMIT=150
RETURN_WINDOW_DAYS=30
NON_RETURNABLE_CATEGORIES=gift_card,perishable,personalised
PICKUP_DAYS_AHEAD=7
MAX_VERIFICATION_ATTEMPTS=3
FRUSTRATION_THRESHOLD=0.6
MAX_AGENT_STEPS=8
HISTORY_MESSAGES=20

# --- Storage ---
MEMORY_MAX_ROWS=50
MEMORY_PATH=runtime/memory.xlsx
STATE_PATH=runtime/state.json

# --- Server ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*
FOLLOW_UP_POLL_SECONDS=30
# Open cases with no return awaiting pickup/refund are resolved after this many idle hours (0 = never)
AUTO_RESOLVE_HOURS=72
