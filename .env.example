# Copy to .env and fill in. Only OPENAI_API_KEY and OPENAI_BASE_URL are normally needed.

# --- LLM (OpenAI-compatible llama.cpp server) ---
OPENAI_API_KEY=your-llama-server-api-key
# Must include /v1, e.g. http://192.168.1.50:8080/v1
OPENAI_BASE_URL=http://localhost:8080/v1
# llama.cpp serves whatever model it loaded; this name is mostly informational
LLM_MODEL=local-model
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=120
# Constrain output to JSON via response_format (llama.cpp grammar). Auto-disables if the server rejects it.
LLM_JSON_MODE=true

# --- Agent authority & policy ---
CURRENCY=USD
RETURN_AUTHORITY_LIMIT=150
RETURN_WINDOW_DAYS=30
NON_RETURNABLE_CATEGORIES=gift_card,perishable,personalised
PICKUP_DAYS_AHEAD=7
MAX_VERIFICATION_ATTEMPTS=3
FRUSTRATION_THRESHOLD=0.6
MAX_AGENT_STEPS=8
HISTORY_MESSAGES=20

# --- Storage ---
MEMORY_MAX_ROWS=50
MEMORY_PATH=runtime/memory.xlsx
STATE_PATH=runtime/state.json

# --- Server ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*
FOLLOW_UP_POLL_SECONDS=30
